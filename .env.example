# Copy this to ~/.leetcode-save.env and fill in your values

# ── LeetCode cookies ───────────────────────────────────────────────────────────
# How to get these:
#   1. Open leetcode.com and log in
#   2. Open DevTools → Application → Cookies → https://leetcode.com
#   3. Copy the value of LEETCODE_SESSION
#   4. Copy the value of csrftoken
LEETCODE_SESSION=your_session_cookie_here
LEETCODE_CSRF=your_csrftoken_here

# Your LeetCode username (needed for --latest flag)
LEETCODE_USERNAME=your_leetcode_username

# ── GitHub repo ────────────────────────────────────────────────────────────────
# Absolute path to where you cloned your solutions repo
# e.g. /Users/yourname/code/leetcode-solutions
GITHUB_REPO_PATH=/path/to/your/cloned/repo
