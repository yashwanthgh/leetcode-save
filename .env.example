# Reference only — you should never need to edit this by hand.
#
# Run `leetcode-save --login` instead. It asks you to paste a "Copy as cURL"
# command from Chrome, then writes ~/.leetcode-save.env for you: both cookies,
# your username, and the path to your solutions repo.
#
# This file documents what ends up in there.

# Pulled from the pasted cURL command.
LEETCODE_SESSION=your_session_cookie_here
LEETCODE_CSRF=your_csrftoken_here

# Looked up from LeetCode once the cookies check out.
LEETCODE_USERNAME=your_leetcode_username

# The local clone of your solutions repo. --login prompts for this.
GITHUB_REPO_PATH=/path/to/your/cloned/repo
